{
  "_documentation": {
    "file": "ribbons.json",
    "purpose": "Ribbon options for a bouquet.",
    "lastUpdated": "2026-11-15",
    "conventions": [
      "Top level is an object with two keys: `_documentation` (this block, ignored by the app) and `items` (the array of records the app reads).",
      "Prices are in Philippine pesos (PHP), stored as plain numbers with no currency symbol.",
      "`null` means the value is not known yet. It never means zero. Check for null before doing math on a value.",
      "Enumerated values (type, origin, occasion, mood, etc.) are lowercase, with hyphens instead of spaces where noted.",
      "`id` values are unique and stable. Gaps in the numbering are fine, and ids should not be reused or renumbered.",
      "`image` paths are served from the site root, so `/images/flowers/x.png` means the file `public/images/flowers/x.png`. The image files themselves have not been added yet."
    ],
    "fields": {
      "id": "string. Unique id, format `ribbon-###`.",
      "image": "string. Image path (see conventions).",
      "type": "string. One of: plain, design, sheer.",
      "color": "string. Ribbon color.",
      "design": "string or null. The printed text or pattern, used only for `design` ribbons (for example, `Love is eternal`). Null for plain and sheer ribbons.",
      "active": "boolean. `false` hides the item from the app (unfinished entries or placeholders). Inactive items stay in the file."
    },
    "notes": []
  },
